{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalogId": "https://knolstory.app/a2ui/catalogs/focus-editor/v1/catalog.json",
  "title": "KnolStory 집중 편집 화면 카탈로그",
  "description": "A2UI v0.9 catalog for KnolStory's focus editing screens. Screens are composed only from these components. Source rules: DESIGN.md '집중 편집 화면 규칙 — 2026-11-24'.",
  "instructions": "Compose one FocusScreen per editing task. 쓰기 is a single-cut screen (CurrentCut); the other tasks are list screens (a CutList of CutItems in work) (basic=쓰기, text=원고, background=배경, characters=인물, audio=음향, direction=연출). The skeleton is fixed: topBar (CutNavigator + WorkTabs) → stage (only when the task needs the scene) → current (the current cut's speaker and text, always visible) → work (the task's tools: choose/change first, remove last) → more (rarely used tools, collapsed). There is no free Text component: standing explanations are not allowed. Speak only through Notice, and only for an empty state, an error or an irreversible action. Put terms and how-to in an IconButton(help) or the Button title. One way per job: two controls with the same action on one screen are rejected unless their devices never overlap. Only one Button may be variant=primary. A ToolGroup holds at most 4 controls. Spacing is chosen from 4/8/12/16/24 only; the renderer owns sizes (visible controls 32–36px, touch targets 44px). Closing is IconButton(icon=close) with a name like '… 닫기', never a text '닫기' button. CutCard (previous/next cut with a scene preview) is tablet/desktop context only. Labels are short Korean in 해요체 where a sentence is needed. Use Slot for parts the screen draws itself (asset browser, stage, timeline); never put controls of the catalog inside a Slot. Components marked x-host are custom catalog components: the catalog fixes their place and props; the screen registers how they are drawn. Use them instead of Slot whenever a named one fits.",
  "$defs": {
    "Device": {
      "type": "string",
      "enum": [
        "phone",
        "phoneLandscape",
        "tablet",
        "desktop"
      ]
    },
    "Devices": {
      "type": "array",
      "description": "Devices that show this component. Omit to show it everywhere.",
      "items": {
        "$ref": "#/$defs/Device"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "Task": {
      "type": "string",
      "enum": [
        "basic",
        "text",
        "background",
        "characters",
        "audio",
        "direction"
      ]
    },
    "Gap": {
      "type": "integer",
      "enum": [
        4,
        8,
        12,
        16,
        24
      ]
    }
  },
  "components": {
    "FocusScreen": {
      "type": "object",
      "description": "One focus editing screen. Must be the component with id 'root'. Single-cut screens (쓰기) put the current cut in `current`; list screens (원고·배경·인물·음향·연출) put a CutList in `work`, and its current CutItem is the current cut.",
      "allowedParents": [],
      "properties": {
        "component": {
          "const": "FocusScreen"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "topBar": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "stage": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "current": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "context": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "work": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "more": {
          "$ref": "common_types.json#/$defs/ComponentId"
        }
      },
      "required": [
        "component",
        "task",
        "topBar",
        "work"
      ]
    },
    "TopBar": {
      "type": "object",
      "description": "설정 · ‹ 1장 · 3컷 ▾ › · 작업 탭 · 전체 화면 · 서재. One row on tablet and up, two rows on phone portrait.",
      "allowedParents": [
        "FocusScreen"
      ],
      "properties": {
        "component": {
          "const": "TopBar"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "settings": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "navigator": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "tabs": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "actions": {
          "$ref": "common_types.json#/$defs/ChildList",
          "maxItems": 2
        },
        "drawer": {
          "$ref": "common_types.json#/$defs/ComponentId"
        }
      },
      "required": [
        "component",
        "settings",
        "navigator",
        "tabs"
      ]
    },
    "CutNavigator": {
      "type": "object",
      "description": "The single chapter/cut place: ‹ 1장 · 3컷 ▾ ›. Shows only the short position; chapter titles and first words of cuts are inside the list (a native select grouped by chapter). The arrows may come from the open screen through the `steps` Slot.",
      "allowedParents": [
        "TopBar"
      ],
      "properties": {
        "component": {
          "const": "CutNavigator"
        },
        "chapter": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "cut": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "previous": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "next": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "openList": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "short": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "label",
              "options"
            ],
            "additionalProperties": false
          }
        },
        "value": {
          "$ref": "common_types.json#/$defs/DataBinding"
        },
        "change": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        },
        "steps": {
          "$ref": "common_types.json#/$defs/ComponentId"
        }
      },
      "required": [
        "component",
        "chapter",
        "cut"
      ]
    },
    "WorkTabs": {
      "type": "object",
      "description": "쓰기·원고·배경·인물·음향·연출. Shows only the tasks the author opened.",
      "allowedParents": [
        "TopBar"
      ],
      "properties": {
        "component": {
          "const": "WorkTabs"
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "selected": {
          "$ref": "#/$defs/Task"
        },
        "change": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "titles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 40
          }
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        }
      },
      "required": [
        "component",
        "tabs",
        "selected",
        "change"
      ]
    },
    "Stage": {
      "type": "object",
      "description": "The single Ren'Py scene for the current cut. Only on tasks that need the scene. With phoneStrip, a portrait phone starts with a 96px strip (background and characters) and one toggle opens or closes it; the choice is remembered on the device.",
      "allowedParents": [
        "FocusScreen"
      ],
      "properties": {
        "component": {
          "const": "Stage"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait"
          ]
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "phoneStrip": {
          "type": "boolean"
        },
        "toggle": {
          "$ref": "common_types.json#/$defs/Action"
        }
      },
      "required": [
        "component",
        "orientation",
        "name"
      ]
    },
    "CurrentCut": {
      "type": "object",
      "description": "Work-area head: number, speaker, the cut's text and play. Visible on every single-cut focus screen. On 쓰기 the head holds the speaker and kind fields (tools) and the full text is edited in place.",
      "allowedParents": [
        "FocusScreen"
      ],
      "properties": {
        "component": {
          "const": "CurrentCut"
        },
        "cut": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "speaker": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "editable": {
          "type": "boolean"
        },
        "play": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "linkedImages": {
          "$ref": "common_types.json#/$defs/ChildList",
          "maxItems": 4
        },
        "tools": {
          "$ref": "common_types.json#/$defs/ChildList",
          "maxItems": 3
        }
      },
      "required": [
        "component",
        "cut",
        "speaker",
        "text"
      ]
    },
    "CutCard": {
      "type": "object",
      "description": "The neighbour place before/after the current cut. kind=cut: the neighbouring cut with a scene preview (preview Slot) — tablet/desktop context only (rule 4). kind=add: the empty next place offers the next cut. kind=none: an empty place said in one short line (story start, no cut).",
      "allowedParents": [
        "FocusScreen",
        "Column"
      ],
      "properties": {
        "component": {
          "const": "CutCard"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "side": {
          "type": "string",
          "enum": [
            "previous",
            "next"
          ]
        },
        "cut": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "select": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cut",
            "add",
            "none"
          ]
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "order": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 12
        },
        "preview": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        }
      },
      "required": [
        "component",
        "side",
        "text"
      ]
    },
    "Column": {
      "type": "object",
      "description": "Vertical group of tool groups inside the work area or More.",
      "allowedParents": [
        "Column",
        "CutItem",
        "FocusScreen",
        "More",
        "ToolGroup"
      ],
      "properties": {
        "component": {
          "const": "Column"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "gap": {
          "$ref": "#/$defs/Gap"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "element": {
          "type": "string",
          "enum": [
            "div",
            "section",
            "span",
            "aside"
          ]
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "ToolGroup": {
      "type": "object",
      "description": "One row of related controls. At most 4 controls (rule 6). `name` is the group's accessible name; labelVisible also shows it as a small caption (e.g. 함께 보기 before its chips).",
      "allowedParents": [
        "Column",
        "CutItem",
        "Drawer",
        "FocusScreen",
        "More"
      ],
      "properties": {
        "component": {
          "const": "ToolGroup"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "gap": {
          "type": "integer",
          "enum": [
            4,
            8
          ]
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "minItems": 1,
          "maxItems": 4
        },
        "labelVisible": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "name",
        "children"
      ]
    },
    "Button": {
      "type": "object",
      "description": "Text button. Visible height 32–36px, touch target 44px. Font is never larger than body text. `name` is the accessible name when the visible label is shorter (e.g. ▶ 재생 → 이 컷부터 재생); an optional icon sits before the label.",
      "allowedParents": [
        "More",
        "Notice",
        "ToolGroup"
      ],
      "properties": {
        "component": {
          "const": "Button"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "quiet"
          ]
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "icon": {
          "type": "string",
          "enum": [
            "play"
          ]
        }
      },
      "required": [
        "component",
        "label",
        "action"
      ]
    },
    "IconButton": {
      "type": "object",
      "description": "Icon-only button (16–20px icon, 44px target). The name is read aloud and shown as a tooltip. keepFocus keeps the writer's text focus (pointer down does not move focus). An optional short visible label may follow the icon (e.g. ⌂ 서재); pressed marks a toggle (전체 화면).",
      "allowedParents": [
        "CutNavigator",
        "Drawer",
        "Notice",
        "ToolGroup",
        "TopBar"
      ],
      "properties": {
        "component": {
          "const": "IconButton"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "icon": {
          "type": "string",
          "enum": [
            "close",
            "fullscreen",
            "fullscreen-exit",
            "help",
            "library",
            "next",
            "play",
            "previous"
          ]
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "keepFocus": {
          "type": "boolean"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 8
        },
        "pressed": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        }
      },
      "required": [
        "component",
        "icon",
        "name",
        "action"
      ]
    },
    "Choice": {
      "type": "object",
      "description": "Pick one value (select). The label is visible and short; `name` is the accessible name when it differs.",
      "allowedParents": [
        "Column",
        "CurrentCut",
        "More",
        "ToolGroup"
      ],
      "properties": {
        "component": {
          "const": "Choice"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 12
        },
        "value": {
          "$ref": "common_types.json#/$defs/DataBinding"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 20
              },
              "disabled": {
                "type": "boolean"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "change": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        }
      },
      "required": [
        "component",
        "label",
        "value",
        "options",
        "change"
      ]
    },
    "Chip": {
      "type": "object",
      "description": "Small status token, e.g. an image linked to the speaker. Shown only when there is something to show.",
      "allowedParents": [
        "Column",
        "CurrentCut",
        "CutItem",
        "ToolGroup"
      ],
      "properties": {
        "component": {
          "const": "Chip"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 40
        },
        "image": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "icon": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "iconSide": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "component",
        "label"
      ]
    },
    "More": {
      "type": "object",
      "description": "Collapsed disclosure for rarely used tools. Starts closed; one open panel at a time; Escape closes the innermost. lead is read before the summary by assistive tech only (e.g. ‘1컷 배경’ + 표시 조정). open/toggle let the screen render heavy contents only when opened. contentShown: the browser keeps the open/closed state (a re-opened screen starts folded) while the screen decides whether the heavy contents are drawn yet; toggle reports each change.",
      "allowedParents": [
        "Column",
        "CutItem",
        "FocusScreen"
      ],
      "properties": {
        "component": {
          "const": "More"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "summary": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 16
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "minItems": 1
        },
        "lead": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "open": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        },
        "toggle": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "wrap": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "contentShown": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        }
      },
      "required": [
        "component",
        "summary",
        "children"
      ]
    },
    "Notice": {
      "type": "object",
      "description": "The only place for sentences: empty state, error, a warning about the current work (e.g. 인물이 많이 겹쳐요), or before an irreversible action.",
      "allowedParents": [
        "Column",
        "CutItem",
        "FocusScreen",
        "Fork",
        "More"
      ],
      "properties": {
        "component": {
          "const": "Notice"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "kind": {
          "type": "string",
          "enum": [
            "empty",
            "error",
            "irreversible",
            "warning"
          ]
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "maxLength": 60
        },
        "actions": {
          "$ref": "common_types.json#/$defs/ChildList",
          "maxItems": 2
        }
      },
      "required": [
        "component",
        "kind",
        "text"
      ]
    },
    "CutList": {
      "type": "object",
      "description": "Cuts of the current cut's chapter, in manuscript order, scrolling inside the list. On phones, phoneShows='current' (default) keeps only the current CutItem; 'all' keeps the whole list (원고).",
      "allowedParents": [
        "FocusScreen",
        "Column"
      ],
      "properties": {
        "component": {
          "const": "CutList"
        },
        "devices": {
          "$ref": "#/$defs/Devices"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "minItems": 1
        },
        "phoneShows": {
          "type": "string",
          "enum": [
            "current",
            "all"
          ]
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "CutItem": {
      "type": "object",
      "description": "One cut in a list screen. Header: the cut label (number · speaker) selects the cut; ▶ plays from it. Then the cut's text (3 lines) and the task's tools for this cut. No other header buttons. showText=false when the tools edit the text itself (원고).",
      "allowedParents": [
        "CutList"
      ],
      "properties": {
        "component": {
          "const": "CutItem"
        },
        "cut": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "speaker": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "current": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
        },
        "select": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "play": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "maxItems": 8
        },
        "showText": {
          "type": "boolean"
        },
        "disabled": {
          "$ref": "common_types.json#/$defs/DynamicBoolean"
