     "task": "audio",
     "topBar": "root-top",
     "current": "current",
     "work": "work",
     "more": "more"
    },
    {
     "id": "root-top",
     "component": "TopBar",
     "settings": {
      "event": {
       "name": "openSettings"
      }
     },
     "navigator": "cut-nav",
     "tabs": "work-tabs",
     "actions": [
      "fullscreen",
      "library"
     ]
    },
    {
     "id": "cut-nav",
     "component": "CutNavigator",
     "chapter": {
      "path": "/chapter"
     },
     "cut": {
      "path": "/cut"
     },
     "previous": {
      "event": {
       "name": "previousCut"
      }
     },
     "next": {
      "event": {
       "name": "nextCut"
      }
     },
     "openList": {
      "event": {
       "name": "openCutList"
      }
     }
    },
    {
     "id": "work-tabs",
     "component": "WorkTabs",
     "tabs": [
      "basic",
      "text",
      "background",
      "characters",
      "audio",
      "direction"
     ],
     "selected": "audio",
     "change": {
      "event": {
       "name": "changeTask"
      }
     }
    },
    {
     "id": "fullscreen",
     "component": "IconButton",
     "icon": "fullscreen",
     "name": "전체 화면",
     "action": {
      "event": {
       "name": "toggleFullscreen"
      }
     }
    },
    {
     "id": "library",
     "component": "IconButton",
     "icon": "library",
     "name": "서재로 나가기",
     "action": {
      "event": {
       "name": "openLibrary"
      }
     }
    },
    {
     "id": "current",
     "component": "CurrentCut",
     "cut": {
      "path": "/cut"
     },
     "speaker": {
      "path": "/speaker"
     },
     "text": {
      "path": "/text"
     },
     "editable": false,
     "play": {
      "event": {
       "name": "playFromCut"
      }
     }
    },
    {
     "id": "work",
     "component": "ToolGroup",
     "name": "음향",
     "children": [
      "pick-bgm",
      "add-sfx"
     ]
    },
    {
     "id": "pick-bgm",
     "component": "Button",
     "label": "배경음 고르기",
     "variant": "primary",
     "action": {
      "event": {
       "name": "pickBgm"
      }
     }
    },
    {
     "id": "add-sfx",
     "component": "Button",
     "label": "효과음 넣기",
     "action": {
      "event": {
       "name": "addSfx"
      }
     }
    },
    {
     "id": "more",
     "component": "More",
     "summary": "더보기",
     "children": [
      "more-tools"
     ]
    },
    {
     "id": "more-tools",
     "component": "ToolGroup",
     "name": "음향 정리",
     "children": [
      "audio-range",
      "remove-audio"
     ]
    },
    {
     "id": "audio-range",
     "component": "Button",
     "label": "음원 구간",
     "action": {
      "event": {
       "name": "editAudioRange"
      }
     }
    },
    {
     "id": "remove-audio",
     "component": "Button",
     "label": "소리 빼기",
     "variant": "quiet",
     "action": {
      "event": {
       "name": "removeAudio"
      }
     }
    }
   ]
  }
 },
