{
  "name": "knolstory-next",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @knolstory/web dev",
    "build": "python3 scripts/check-service-audio.py && turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:server",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=host",
    "test:e2e:runtime": "playwright test --project=runtime --project=runtime-dpr-1.5 --project=runtime-dpr-2",
    "test:e2e:stories": "playwright test --project=stories-runtime",
    "test:presenter": "node spikes/renpy-web/verify-presenter.mjs",
    "test:media-provenance": "python3 scripts/media-provenance.py --check",
    "env:prepare": "python3 scripts/test-environment.py prepare",
    "env:doctor": "python3 scripts/test-environment.py doctor",
    "env:verify": "python3 scripts/test-environment.py verify",
    "runtime:prepare": "python3 scripts/prepare-runtime.py",
    "runtime:build": "python3 spikes/renpy-web/build.py",
    "test:scripts": "python3 -m unittest discover -s scripts/tests",
    "preview": "python3 scripts/serve-test-build.py",
    "docs:check": "node scripts/check-project-docs.mjs && node scripts/check-product-language.mjs",
    "test:docs": "node --test scripts/tests/project-docs.test.mjs scripts/tests/product-language.test.mjs",
    "test:service-audio": "python3 scripts/check-service-audio.py",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:office-roundtrip": "vitest run --config packages/compatibility/tests/office-roundtrip.vitest.config.ts",
    "test:e2e:office": "playwright test --config packages/compatibility/tests/office-browser.playwright.config.ts",
    "delivery:inventory": "python3 scripts/static-delivery-audit.py",
    "delivery:check": "python3 scripts/static-delivery-audit.py --check",
    "delivery:prepare": "python3 scripts/prepare-static-candidate.py",
    "delivery:preview": "python3 scripts/serve-static-candidate.py",
    "delivery:verify": "python3 scripts/verify-static-deployment.py",
    "test:e2e:static": "playwright test --config tests/static-delivery.playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "pngjs": "7.0.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
