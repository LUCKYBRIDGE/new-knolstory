FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production
WORKDIR /app
COPY server/operations/production-ingress.mjs server/operations/trusted-ingress-socket.mjs ./operations/
COPY server/http/client-bucket-proof.mjs ./http/
COPY apps/web/out /site
RUN chmod -R a+rX /site
USER node
EXPOSE 8080
CMD ["node", "operations/production-ingress.mjs"]
