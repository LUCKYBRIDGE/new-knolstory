        "chapterId": "e68c27bb-7614-4159-b142-b0e8f809c5a3",
        "order": 2,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "흥부",
        "text": "우리는 서로 손을 잡고 다리로 향했다.",
