        "chapterId": "b3ed24aa-7e42-4821-bd12-d8229bc0bce2",
        "order": 2,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "흥부",
        "text": "제비가 알려 준 길을 따라 다리로 향했다.",
        "leftAssetId": "heungbu.character.heungbu-young",
        "rightAssetId": "",
        "backgroundId": "seonnyeo.background.BG-forest-roots",
        "inheritActors": false,
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
