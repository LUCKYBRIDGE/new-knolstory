    "lines": [
      {
        "id": "47846eb3-cf9f-42d5-be3f-a991a136e865",
        "chapterId": "50755f8d-4076-4d96-8dd3-bfc6d607fca9",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "",
        "text": "아침 빛이 작은 숲을 깨웠다.",
        "leftAssetId": "heungbu.character.heungbu-young",
        "rightAssetId": "",
        "backgroundId": "",
        "inheritActors": false,
        "purposeNote": "",
        "emotionNote": "",
