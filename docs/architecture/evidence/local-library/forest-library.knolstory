              "targetLineId": "b0ec902a-475d-4b96-a15b-06115291157e"
            },
            {
              "id": "463d2570-e6c7-4929-81ea-617096120bc5-choice-2",
              "label": "별빛의 길로 가기",
              "targetLineId": "8847e82f-51bb-4dbc-ad9e-3fec0a64cc8b"
            }
          ]
        }
      },
      {
        "id": "b0ec902a-475d-4b96-a15b-06115291157e",
        "chapterId": "b3ed24aa-7e42-4821-bd12-d8229bc0bce2",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "coSpeakerNames": [],
        "text": "햇빛 아래에서 작은 제비를 만났다.",
        "leftAssetId": "",
        "rightAssetId": "",
        "backgroundId": "seonnyeo.background.BG-forest-roots",
        "inheritActors": false,
        "workingTitle": "",
        "purposeNote": "",
