    +         "chapterId": "classic-seonnyeo-1",
    +         "directionNote": "",
    +         "emotionNote": "",
    +         "id": "classic-seonnyeo-1-line-09",
    +         "leftAssetId": "seonnyeo.character.M02-neutral",
    +         "order": 9,
    +         "purposeNote": "",
    +         "rightAssetId": "seonnyeo.character.classic-deer",
    +         "speaker": "right",
    +         "speakerName": "사슴",
    +         "stageComposition": Object {
