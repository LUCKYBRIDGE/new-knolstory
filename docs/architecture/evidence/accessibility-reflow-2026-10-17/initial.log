    +         "backgroundId": "seonnyeo.background.BG01-valley-day",
    +         "chapterId": "classic-seonnyeo-1",
    +         "directionNote": "",
    +         "emotionNote": "",
    +         "id": "classic-seonnyeo-1-line-04",
    +         "leftAssetId": "seonnyeo.character.M02-neutral",
    +         "order": 4,
    +         "purposeNote": "",
    +         "rightAssetId": "seonnyeo.character.classic-deer",
    +         "speaker": "right",
