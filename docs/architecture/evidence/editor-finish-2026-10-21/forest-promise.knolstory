        {
          "id": "11ada872-445d-4f47-b353-22d67b34d916",
          "chapterId": "ca614be7-af48-42a9-bb50-15bb1e4450f6",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "흥부는 친구에게 줄 선물을 챙겼다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "actor-5c36c371-1408-4d91-ac3c-6ca930dcbe8b",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "actor-5c36c371-1408-4d91-ac3c-6ca930dcbe8b",
            "speakerActorKeys": [
              "actor-5c36c371-1408-4d91-ac3c-6ca930dcbe8b"
            ]
          }
        },
        {
          "id": "954bff22-165d-43c8-8932-e028731667a8",
          "chapterId": "ca614be7-af48-42a9-bb50-15bb1e4450f6",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "나는 흥부와 함께 숲 입구로 걸었다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "flow": {
            "type": "goto",
            "targetLineId": "646a8de0-0e0d-4c35-9c54-76c61b750e21"
          }
        },
        {
          "id": "646a8de0-0e0d-4c35-9c54-76c61b750e21",
          "chapterId": "873069a1-7bfb-41fe-b4de-97b9f1d71314",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "",
          "text": "숲 깊은 곳에서 두 길이 나타났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "presentation": {
            "clearFollowingEffects": true
          }
        },
        {
          "id": "8dbcc05b-57f4-4108-9325-ef04c9f77c9f",
          "chapterId": "873069a1-7bfb-41fe-b4de-97b9f1d71314",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "밝은 길에서는 새가 노래하고, 밤길에서는 별이 빛났다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "actor-58e12d09-2c02-4f47-b972-6069d510245a",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "actor-58e12d09-2c02-4f47-b972-6069d510245a",
            "speakerActorKeys": [
              "actor-58e12d09-2c02-4f47-b972-6069d510245a"
            ]
          }
        },
        {
          "id": "570b826e-0479-4a77-b395-074f9ee3713a",
          "chapterId": "873069a1-7bfb-41fe-b4de-97b9f1d71314",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "어느 길로 친구를 찾아갈까?",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
