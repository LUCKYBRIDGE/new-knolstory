          "speaker": "narration",
          "speakerName": "해설",
          "coSpeakerNames": [],
          "text": "햇빛 아래에서 작은 제비를 만났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "workingTitle": "",
          "purposeNote": "",
