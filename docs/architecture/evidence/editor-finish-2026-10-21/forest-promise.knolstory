          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          }
        },
        {
          "id": "602d7b4b-8165-4fe0-b533-5da4f08bbd97",
          "chapterId": "7fc3b6c3-aabc-442b-a23e-ef21351aa8ce",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "제비가 알려 준 길을 따라 다리로 향했다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
