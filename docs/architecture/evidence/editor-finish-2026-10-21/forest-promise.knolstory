          "type": "narration",
          "speaker": "narration",
          "speakerName": "",
          "text": "아침 빛이 작은 숲을 깨웠다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "",
          "inheritActors": false,
          "purposeNote": "",
