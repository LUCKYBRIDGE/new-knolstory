        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:23",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 24,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "또 다른 옹고집",
        "text": "주먹밥은 길에서 드시오. 짚신도 갈아 신으시오.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.double-blue-offering-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
