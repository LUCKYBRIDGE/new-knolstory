          "rightActors": []
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:36",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 37,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "분노한 옹고집",
        "text": "내 자식이 저놈에게 붙다니. 이리 오지 못하느냐.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
