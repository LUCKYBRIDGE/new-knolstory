        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:22",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 23,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "일어나지 못한 채 앉아 있을 때, 누군가 그의 앞에 주먹밥 두 개와 낡은 짚신을 내려놓았다.",
        "leftAssetId": "",
        "rightAssetId": "",
        "backgroundId": "onggojib.scene.shortstory-knolstory-04",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
