        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:40",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 41,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 뒤따라 몇 걸음 나섰지만 눈 위의 발자국은 곧 끊겨 있었다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
