        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:20",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 21,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "막내가 엿을 하나 집었다. 둘째도 따라 손을 내밀었다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "",
