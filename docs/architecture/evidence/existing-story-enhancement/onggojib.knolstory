        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:6",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 7,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "여인의 목소리",
        "text": "서방님, 저 사람 손이 다 터졌습니다. 죽 한 그릇만 내주면 안 되겠습니까.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
