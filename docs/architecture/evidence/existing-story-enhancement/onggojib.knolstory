        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "flow": {
          "type": "choice",
          "options": [
            {
              "id": "act-kind",
              "label": "그래. 이리 앉아 보아라. 까치가 어찌 되었느냐.",
