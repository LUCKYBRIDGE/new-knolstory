            }
          ]
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:39",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 40,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 뒤따라 몇 걸음 나섰지만 눈 위의 발자국은 곧 끊겨 있었다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:40",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 41,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 다시 대문을 두드리자 안쪽에서 빗장이 풀렸다. 부인이 문을 열었다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.wife-concerned-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
