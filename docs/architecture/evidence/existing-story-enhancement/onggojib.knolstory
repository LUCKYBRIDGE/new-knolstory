            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:0",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "다음 날, 옹고집은 국을 한 술 뜨자마자 목소리를 높였다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:1",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 2,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "그 가짜 놈이 있을 때는 식은 국도 웃으며 먹었느냐. 이제 내 상 하나 제대로 못 차리는구나.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:2",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 3,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "막내가 울음을 참자 부인은 아이 쪽으로 갔다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:3",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 4,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "또 아이 편부터 드는 거요? 그놈이 며칠 다정한 척했다고 이 집 법도까지 바뀐 줄 아시오.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:4",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 5,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "며칠 뒤, 옹고집은 이웃 고을 장터에 다녀오겠다며 집을 나섰다.",
        "leftAssetId": "creative.character.onggojib-real-walking",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "creative.character.onggojib-real-walking"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:5",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 6,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 집을 나서자 둘째는 며칠 전 못다 한 마당 이야기를 꺼냈다. 막내도 따라 웃었다.",
        "leftAssetId": "",
        "rightAssetId": "onggojib.character.second-child-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "right": {
              "facing": "left"
            }
          }
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.second-child-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:6",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 7,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그날 저녁, 같은 얼굴의 사람이 예고 없이 돌아왔다. 아이들은 마루 끝으로 달려 나갔다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "left"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.second-child-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:7",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 8,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "둘째",
        "text": "아버지, 오늘 마당에서 있었던 일도 이야기해도 돼요?",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
