        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:9",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 10,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "거저 달라는 뜻은 아닙니다. 시킬 일이 있으면 하겠습니다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.snow-village-road-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
