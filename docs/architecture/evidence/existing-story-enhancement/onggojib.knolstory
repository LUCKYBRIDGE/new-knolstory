            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-offering-consistent-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:25",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 26,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 고개를 들자, 눈발 사이로 저와 꼭 같은 얼굴이 보였다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:26",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 27,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "당신은 대체 누구요. 왜 나와 같은 얼굴을 하고 있소?",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
