      {
        "id": "review-main-003:fake-first-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:0",
        "chapterId": "review-main-003:fake-first-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 1,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "아이들을 지켜 준 저 사람과 돌아가겠습니다.",
