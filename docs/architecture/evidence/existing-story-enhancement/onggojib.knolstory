              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:9",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 10,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "또 다른 옹고집",
        "text": "눈발이 거세졌소. 날이 밝는 대로 떠날 테니 오늘 밤만 사랑채를 빌려 주시오.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "left"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.second-child-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:10",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 11,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "부인은 망설이다 사랑채만 내주었다. 아이들은 사랑채 문간에 앉아 낮에 본 일을 이야기했다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:11",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 12,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "동틀 무렵, 또 다른 옹고집이 사랑채에서 나와 떠날 채비를 할 때 진짜 옹고집이 대문을 거칠게 열고 들어왔다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:12",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 13,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "분노한 옹고집",
        "text": "또 너냐! 감히 내 집과 처자식, 내 이름까지 다시 빼앗으려 드느냐!",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:13",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 14,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "이웃들이 다시 관아에 알렸고, 포졸들은 두 사람과 가족을 데려갔다. 사또가 묻기도 전에 옹고집이 먼저 소리쳤다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:14",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 15,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "분노한 옹고집",
        "text": "사또 나리, 지난번에도 부인이 나와 돌아가겠다고 했습니다. 이번에는 더 물을 것도 없습니다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:15",
        "chapterId": "review-main-003:real-loop-testimony-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 16,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "사또",
        "text": "부인, 다시 묻겠다. 이번에는 누구와 집으로 돌아가겠느냐.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
