              "facing": "left"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "creative.character.onggojib-real-bowing"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
