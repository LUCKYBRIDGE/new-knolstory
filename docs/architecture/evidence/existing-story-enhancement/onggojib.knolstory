        "order": 26,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "며칠 동안, 아이들은 그가 밥상에 앉아도 먼저 말을 꺼냈다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
