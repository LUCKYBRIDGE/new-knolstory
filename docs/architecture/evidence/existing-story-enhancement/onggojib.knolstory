      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:30",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 31,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "또 다른 옹고집",
        "text": "당신인 줄 모르고도 내놓았소.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
