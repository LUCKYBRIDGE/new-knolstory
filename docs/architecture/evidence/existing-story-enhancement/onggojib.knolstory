        }
      },
      {
        "id": "review-main-003:b-vase-care-after-harsh:3",
        "chapterId": "review-main-003:b-vase-care-after-harsh",
        "order": 4,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "둘째는 아버지의 얼굴을 살피다가 조심스럽게 입을 열었다.",
        "leftAssetId": "onggojib.character.real-remorse-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-hesitant-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
