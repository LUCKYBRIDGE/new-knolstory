              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route:7",
        "chapterId": "review-main-003:fake-route",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "눈발이 거세 집 모양도 제대로 보이지 않았다. 옹고집이 큰 대문을 두드리자 누군가 문틈으로 내다보았다.",
        "leftAssetId": "",
        "rightAssetId": "",
