              "assetId": "onggojib.character.real-exiled-pleading-v2-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:6",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 7,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "여인의 목소리",
        "text": "서방님, 저 사람 손이 다 터졌습니다. 죽 한 그릇만 내주면 안 되겠습니까.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:7",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "옹고집은 아내의 목소리를 알아듣고 입을 열었다가 아무 말도 하지 못했다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.snow-village-road-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:8",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 9,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "문 안의 사내",
        "text": "거지에게 내줄 밥은 없다. 썩 물러가라.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
