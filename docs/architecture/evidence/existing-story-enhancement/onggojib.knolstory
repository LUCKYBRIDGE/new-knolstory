        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:34",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 35,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "옹고집",
        "text": "일주일이라니……. 아내는 관아에서 있었던 일도 기억하지 못하오?",
