        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:38",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 39,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "부인은 소리친 남편과 막내 앞을 막아 선 사람을 번갈아 보았다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:39",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 40,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "사또",
        "text": "누가 진짜 옹고집인지 가릴 길이 없구나. 부인, 누구와 집으로 돌아가겠느냐.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "flow": {
          "type": "choice",
          "options": [
            {
              "id": "point-real",
              "label": "오래 함께 산 옹고집과 돌아간다",
              "targetLineId": "review-main-003:real-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:0"
            },
            {
              "id": "point-double",
              "label": "아이를 감싸 준 옹고집과 돌아간다",
              "targetLineId": "review-main-003:fake-first-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:0"
            }
