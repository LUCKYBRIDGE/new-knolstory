      },
      {
        "id": "review-main-003:fake-first-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:2",
        "chapterId": "review-main-003:fake-first-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 3,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "서방님인 것은 압니다. 하지만 아이들이 다시 당신 눈치만 보며 살게 할 수는 없습니다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
