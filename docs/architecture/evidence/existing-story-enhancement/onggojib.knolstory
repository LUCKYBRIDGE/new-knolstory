      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:35",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 36,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "사또",
        "text": "관아 마당에서 소리부터 높이지 마라. 한 걸음 물러서라.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
