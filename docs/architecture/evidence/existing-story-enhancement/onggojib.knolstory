      },
      {
        "id": "review-main-003:real-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:8",
        "chapterId": "review-main-003:real-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 9,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 둘째를 노려보자, 아이는 하려던 말을 그만두었다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.second-child-hesitant-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
