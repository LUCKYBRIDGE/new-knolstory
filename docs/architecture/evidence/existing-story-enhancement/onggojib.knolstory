      },
      {
        "id": "review-main-003:fake-repeat-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:2",
        "chapterId": "review-main-003:fake-repeat-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 3,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "서방님이 오래 함께 산 제 남편인 것은 압니다.",
