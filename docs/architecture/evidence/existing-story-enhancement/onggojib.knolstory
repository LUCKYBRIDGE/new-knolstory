      {
        "id": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:5",
        "chapterId": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 6,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "사또",
        "text": "부인이 정한 사람은 가족과 집으로 돌아가라. 다른 한 사람은 관아 밖으로 물러나라.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.magistrate-command-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:6",
        "chapterId": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 7,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 마당에 버티고 서자 포졸들이 양팔을 붙잡아 관아 밖으로 끌어냈다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.posol-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "left"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.posol-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:7",
        "chapterId": "review-main-003:fake-repeat-verdict-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "부인은 아이들의 손을 잡고 또 다른 옹고집과 함께 관아를 나섰다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-concerned-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
