      },
      {
        "id": "review-main-003:real-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:6",
        "chapterId": "review-main-003:real-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 7,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "아이들이 아직 놀랐습니다. 오늘 밤은 제가 아이들 곁에 있겠습니다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
