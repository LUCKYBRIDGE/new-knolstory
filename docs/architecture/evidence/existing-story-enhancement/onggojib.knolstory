      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:13",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 14,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "며칠 뒤, 대문 밖에서 남편의 목소리가 들렸다. 부인이 문을 열자 옹고집과 똑같이 생긴 사내가 서 있었다.",
        "leftAssetId": "",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
