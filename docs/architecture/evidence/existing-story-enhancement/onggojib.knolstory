        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:7",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "옹고집은 아내의 목소리를 알아듣고 입을 열었다가 아무 말도 하지 못했다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
