      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:32",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 33,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "관아 마당에 두 옹고집이 나란히 섰다. 포졸들도 두 사람을 구별하지 못했다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
