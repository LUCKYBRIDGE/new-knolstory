      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:38",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 39,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "또 다른 옹고집",
        "text": "이제 다시 대문을 두드려 보시오.",
