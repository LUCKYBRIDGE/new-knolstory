      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:8",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 9,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "낯선 사내",
        "text": "버리는 짚신이라도 좋습니다. 눈길을 걸을 것만 주십시오.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.stranger-hidden-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
