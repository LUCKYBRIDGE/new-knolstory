              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route:6",
        "chapterId": "review-main-003:fake-route",
        "order": 7,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "옹고집",
        "text": "누구를 탓할 힘도 없고, 돌아갈 곳도 없었다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
