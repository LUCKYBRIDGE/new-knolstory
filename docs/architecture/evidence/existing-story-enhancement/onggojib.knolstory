      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:35",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 36,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "또 다른 옹고집",
        "text": "그 기억은 당신에게만 남을 것이오.",
