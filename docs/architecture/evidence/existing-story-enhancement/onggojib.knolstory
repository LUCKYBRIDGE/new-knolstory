          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:34",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 35,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "분노한 옹고집",
        "text": "더 물을 것도 없습니다! 저놈을 당장 끌어내십시오. 내가 이 집 주인이오.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
