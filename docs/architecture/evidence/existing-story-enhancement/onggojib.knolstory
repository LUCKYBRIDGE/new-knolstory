              "assetId": "audio:sound:sfx-door",
              "volume": 0.5
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:15",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 16,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "밖이 춥소. 아이들은 안으로 들이시오. 부인도 오래 서 있지 마시오.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
