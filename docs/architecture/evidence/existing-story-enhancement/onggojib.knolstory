              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "creative.character.onggojib-real-bowing"
