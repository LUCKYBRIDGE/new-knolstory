      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:0",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 1,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "거지에게 내줄 밥은 없다. 썩 물러가라.",
