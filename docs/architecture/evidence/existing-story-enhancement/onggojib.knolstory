        "chapterId": "review-main-003:b-fake-warning",
        "order": 14,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "진짜 옹고집은 닫힌 대문 앞에 홀로 남았다.",
        "leftAssetId": "",
        "rightAssetId": "creative.character.onggojib-ghost-neutral",
        "backgroundId": "onggojib.background.snow-village-road-pixel",
        "purposeNote": "",
