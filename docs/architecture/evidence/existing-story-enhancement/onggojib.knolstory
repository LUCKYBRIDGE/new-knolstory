          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.stranger-hidden-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:9",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 10,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "서방님, 헛간에 낡은 짚신이 한 켤레 있습니다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:10",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 11,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "버리는 짚신도 네 몫은 없다. 맨발로 가든 기어가든 내 알 바 아니오.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.stranger-hidden-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right",
              "scaleMultiplier": 0.98
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.stranger-hidden-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:11",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 12,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 안방으로 들어간 뒤, 부인은 남편 몰래 길에서 먹을 주먹밥 두 개와 낡은 짚신을 대문 밖 처마 밑에 놓았다.",
        "leftAssetId": "",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:12",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 13,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "날이 밝기 전, 사내는 주먹밥을 품에 넣고 낡은 짚신으로 갈아 신은 뒤 대문을 떠났다.",
        "leftAssetId": "",
        "rightAssetId": "onggojib.character.stranger-hidden-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "right": {
              "facing": "right",
              "scaleMultiplier": 0.98
            }
          }
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.stranger-hidden-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:13",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 14,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "다음 날, 옹고집은 장사길에 오른다며 집을 나섰다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:14",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 15,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "며칠 뒤, 대문 밖에서 남편의 목소리가 들렸다. 부인이 문을 열자 옹고집과 똑같이 생긴 사내가 서 있었다.",
        "leftAssetId": "",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-pixel"
