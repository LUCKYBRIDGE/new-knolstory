      },
      {
        "id": "review-main-003:b-vase-stick:1",
        "chapterId": "review-main-003:b-vase-stick",
        "order": 2,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "일꾼은 대답하지 않고 고개를 숙였다. 갈라진 손등에는 장작가루가 묻어 있었다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.worker-asking-v2-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
