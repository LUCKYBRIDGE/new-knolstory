          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-first-verdict:4",
        "chapterId": "review-main-003:fake-first-verdict",
        "order": 5,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "옹고집이 사또 앞으로 달려들자 포졸들이 팔을 붙잡았다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.posol-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
