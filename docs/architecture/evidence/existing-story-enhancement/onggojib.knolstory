        "order": 2,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "일꾼들이 돌아간 뒤, 옹고집은 안방으로 들어가 둘째를 불렀다.",
        "leftAssetId": "onggojib.character.real-remorse-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-hesitant-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
