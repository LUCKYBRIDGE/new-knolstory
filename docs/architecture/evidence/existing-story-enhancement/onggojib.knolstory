              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:35",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 36,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "또 다른 옹고집",
        "text": "그렇소. 부인과 아이들은 나를 만난 일도, 관아에 갔던 일도 기억하지 못하오.",
