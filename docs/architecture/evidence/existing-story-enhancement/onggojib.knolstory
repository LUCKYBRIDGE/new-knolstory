      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:5",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 6,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "나리... 밥 한 그릇만 주시오.",
