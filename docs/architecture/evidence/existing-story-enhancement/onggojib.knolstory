        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:5",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 6,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "나리... 밥 한 그릇만 주시오.",
        "leftAssetId": "onggojib.character.real-exiled-pleading-v2-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
