          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:27",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 28,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "또 다른 옹고집",
        "text": "당신이 남에게 한 일을 당신 자리에서 되돌려 준 사람이오.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
