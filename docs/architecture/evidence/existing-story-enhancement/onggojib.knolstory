            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:33",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 34,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "사또가 집안 살림과 오래된 일을 차례로 물었지만 두 사람의 대답은 똑같았다.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "onggojib.character.posol-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
