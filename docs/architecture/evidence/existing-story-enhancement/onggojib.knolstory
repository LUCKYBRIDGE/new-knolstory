          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:32",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 33,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "사또가 집안 살림과 오래된 일을 차례로 물었지만 두 사람의 대답은 똑같았다.",
        "leftAssetId": "onggojib.character.magistrate-command-pixel",
        "rightAssetId": "onggojib.character.posol-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
