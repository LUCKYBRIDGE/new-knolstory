              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
