      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:0",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "시점 전환",
        "text": "쫓겨난 옹고집의 시점",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.snow-village-road-pixel",
        "purposeNote": "",
