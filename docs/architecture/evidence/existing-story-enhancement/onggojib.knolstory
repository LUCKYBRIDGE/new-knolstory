            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": [],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:19",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 20,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "막내가 엿을 하나 집었다. 둘째도 따라 손을 내밀었다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
