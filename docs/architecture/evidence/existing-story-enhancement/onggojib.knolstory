          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-exiled-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:21",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 22,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "몇 걸음 가지 못해 눈길에 주저앉았다. 뒤에서 빗장 거는 소리가 났다.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
