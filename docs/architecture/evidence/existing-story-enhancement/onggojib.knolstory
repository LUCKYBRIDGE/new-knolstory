        "stageComposition": {
          "leftActors": [],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:fake-route:32",
        "chapterId": "review-main-003:fake-route",
        "order": 33,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "또 다른 옹고집",
        "text": "주먹밥은 길에서 드시오. 짚신도 갈아 신으시오.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
