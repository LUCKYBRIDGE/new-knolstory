      {
        "id": "review-main-003:fake-repeat-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:4",
        "chapterId": "review-main-003:fake-repeat-verdict-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 5,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "내가 너희를 굶겼느냐, 헐벗게 했느냐! 집안 법도를 세운 게 죄란 말이냐!",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.magistrate-yard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
