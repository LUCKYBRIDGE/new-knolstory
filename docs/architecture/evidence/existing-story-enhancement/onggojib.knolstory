      {
        "id": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:22",
        "chapterId": "review-main-003:part1-court-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 23,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "그래서 어떻게 되었느냐.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.second-child-hesitant-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
