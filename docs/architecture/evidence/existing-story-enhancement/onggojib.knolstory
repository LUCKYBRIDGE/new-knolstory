              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:29",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 30,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "분노한 옹고집이 한 걸음 다가오자 아이들이 뒤로 물러섰다. 또 다른 옹고집은 아이들 앞에 서서 그를 막았다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            },
            "right": {
              "emphasis": "dim",
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-angry-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ]
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:30",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 31,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "진짜 옹고집의 고함이 대문 밖까지 번졌다. 이웃들이 관아에 알렸고, 포졸들은 두 사람과 가족을 데려갔다.",
        "leftAssetId": "onggojib.character.real-angry-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "backgroundId": "onggojib.background.winter-courtyard-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
