      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:18",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 19,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그가 작은 엿 꾸러미를 상 위에 놓았다. 아이들은 손을 내밀지 못했다.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.double-blue-gentle-consistent-pixel"
            }
          ],
          "rightActors": []
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:19",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 20,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "먹어도 된다. 서로 나누어 먹거라.",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
