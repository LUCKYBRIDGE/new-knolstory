        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:36",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 37,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "또 다른 옹고집",
        "text": "그 기억은 당신에게만 남을 것이오.",
        "leftAssetId": "onggojib.character.real-exiled-consistent-pixel",
        "rightAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
