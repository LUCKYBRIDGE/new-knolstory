      {
        "id": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:39",
        "chapterId": "review-main-003:fake-route-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 40,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그 말만 남기고 그는 눈발 속으로 걸어갔다.",
