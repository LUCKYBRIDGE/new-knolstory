      {
        "id": "review-main-003:b-vase-care-after-harsh:2",
        "chapterId": "review-main-003:b-vase-care-after-harsh",
        "order": 3,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "며칠 전 네 말을 끊은 건 내 잘못이었다. 그때 하려던 이야기를 다시 들려주겠느냐.",
        "leftAssetId": "creative.character.onggojib-real-bowing",
        "rightAssetId": "onggojib.character.second-child-hesitant-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
