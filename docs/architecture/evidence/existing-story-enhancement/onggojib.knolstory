          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-pixel"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl:16",
        "chapterId": "review-main-003:part1-court-cruelty-drive-away__work-no-food__wage-too-slow__shoe-crawl",
        "order": 17,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "서방님… 오늘은 어찌 그런 말씀을 하십니까?",
        "leftAssetId": "onggojib.character.double-blue-gentle-consistent-pixel",
        "rightAssetId": "onggojib.character.wife-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
