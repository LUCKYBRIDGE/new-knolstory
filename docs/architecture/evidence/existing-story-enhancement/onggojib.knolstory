      {
        "id": "review-main-003:b-final-acts:12",
        "chapterId": "review-main-003:b-final-acts",
        "order": 13,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "부인",
        "text": "저는 아직 서방님이 목소리를 높일까 겁부터 납니다. 오래 그렇게 살아 왔으니까요.",
        "leftAssetId": "onggojib.character.real-remorse-consistent-pixel",
        "rightAssetId": "onggojib.character.wife-resolved-pixel",
        "backgroundId": "onggojib.background.warm-room-pixel",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "presentation": {
          "actors": {
            "left": {
              "emphasis": "dim",
              "facing": "right"
            },
            "right": {
              "facing": "right"
            }
          }
        },
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "onggojib.character.real-remorse-consistent-pixel"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "onggojib.character.wife-resolved-pixel"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-003:b-final-acts:13",
        "chapterId": "review-main-003:b-final-acts",
        "order": 14,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "옹고집",
        "text": "그 말을 잊지 않겠소.",
