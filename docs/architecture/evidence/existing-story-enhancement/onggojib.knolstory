      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:55",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 56,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "보름 뒤 저녁, 식사가 끝나자 둘째가 옹고집에게 다가왔다.",
        "leftAssetId": "onggojib.character.real-remorse-consistent-pixel",
