        }
      },
      {
        "id": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty:9",
        "chapterId": "review-main-003:fake-route-cruelty-labor-first__work-promised__wage-wet-wood__shoe-poverty",
        "order": 10,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "문 안의 사내",
        "text": "다 패면 죽 한 그릇과 삯을 주마.",
