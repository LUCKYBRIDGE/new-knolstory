      },
      {
        "id": "review-main-002:obey-route:14",
        "chapterId": "review-main-002:obey-route",
        "order": 15,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "나는 따라 웃지 못했다.",
