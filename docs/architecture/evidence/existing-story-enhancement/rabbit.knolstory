        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-grassland",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:hesitate-route:11",
        "chapterId": "review-main-002:hesitate-route",
        "order": 12,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "그래도 병든 이를 외면하고 돌아서기도 마음에 걸리고.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-grassland",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:hesitate-route:12",
        "chapterId": "review-main-002:hesitate-route",
        "order": 13,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "좋소.\n딱 한 번 가보겠소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
