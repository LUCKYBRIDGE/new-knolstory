      {
        "id": "review-main-002:shield-route:10",
        "chapterId": "review-main-002:shield-route",
        "order": 11,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "……제가 다녀오겠습니다.",
