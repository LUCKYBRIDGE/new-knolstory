        "flow": {
          "type": "choice",
          "options": [
            {
              "id": "truth",
              "label": "간을 몸 밖에 둘 수 없다고 말한다.",
              "targetLineId": "review-main-002:ending-1:0"
            },
            {
              "id": "shield",
              "label": "직접 확인해야 한다고 말해 육지로 갈 기회를 만든다.",
              "targetLineId": "review-main-002:shield-route:0"
            }
          ]
        },
        "stageComposition": {
