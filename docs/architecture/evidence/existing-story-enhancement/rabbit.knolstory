      },
      {
        "id": "review-main-002:shield-route:14",
        "chapterId": "review-main-002:shield-route",
        "order": 15,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "호위들이 토끼를 묶은 줄을 풀었다.",
