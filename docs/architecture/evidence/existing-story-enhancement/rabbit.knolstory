  "project": {
    "cover": {
      "author": "전래 이야기",
      "subtitle": "용궁 속 지혜",
      "authorNote": "「별주부전」의 대표 갈등과 선택을 현대적 시선으로 다룹니다.",
      "layout": "classic",
      "theme": "cream",
      "font": "serif",
      "titlePosition": "top",
      "authorPosition": "bottom",
      "align": "center",
      "titleSize": 40,
      "titleColor": "",
      "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-welcome",
      "characterId": "rabbit-turtle.character.turtle-unified-720x900",
      "characterPosition": "center"
    },
    "id": "pinky-review-main-002",
    "title": "별주부전",
    "description": "병든 용왕을 살려야 하는 자라가 토끼를 속여 데려오라는 명령을 받고, 은혜와 생명의 무게 사이에서 흔들리는 원작 각색 체험형 이야기.",
    "planning": {
      "premise": "병든 용왕을 살려야 하는 자라가 토끼를 데려오라는 명을 받고, 거짓과 진실, 충성과 양심의 기로에 선다.",
      "structureMode": "five",
      "material": "별주부전 / 토끼전 / 수궁가",
      "theme": "상황이 아무리 절박해도 남을 속여 얻은 생명은 온전한 평화가 될 수 없다.",
      "mainCharacter": "자라",
      "mainGoal": "용왕을 살릴 처방을 찾되, 죄 없는 토끼를 희생시키는 일 사이에서 올바른 선택을 하고자 한다.",
      "centralProblem": "용왕의 은혜와 자신의 양심 사이에서 무엇을 고백하고 무엇을 지킬 것인가.",
      "stakes": "선택에 따라 토끼의 생사, 용왕의 신뢰, 자라의 삶의 터전이 완전히 달라진다.",
      "endingChange": "자라는 타인의 명령에 따르던 신하에서 스스로의 선택과 결과를 책임지는 주체로 성장한다.",
      "opening": "병든 용왕을 모시던 자라에게 의관의 처방(토끼의 간)과 용왕의 속임수 명령이 떨어진다.",
      "middle": "육지에서 토끼를 만난 자라는 말을 고르고, 두 동물은 함께 바닷속을 건너 용궁 대청에 이른다.",
      "crisis": "토끼가 함정에 빠지자 기지를 발휘해 간을 두고 왔다고 둘러대고, 용왕은 자라에게 진실을 묻는다.",
      "climax": "자라의 증언에 따라 토끼가 희생되거나 육지로 함께 빠져나온다.",
      "ending": "결과에 따라 진실을 말한 자라, 돌아가지 않은 자라, 돌아와 고백한 자라의 세 갈래 길로 이어진다.",
      "characterNotes": "자라: 은혜를 갚아야 한다는 충심과 무고한 생명을 해치지 않으려는 양심 사이에서 고뇌한다.\n토끼: 위기 앞에서도 침착하게 꾀를 내며 자라의 속임수와 구명을 냉철히 꿰뚫어 본다.\n용왕: 목숨이 경각에 달렸음에도 타인의 생명을 해치는 것에 고뇌하는 입체적인 왕.",
      "worldNotes": "어둡고 위압적인 용궁 대청과 자유롭고 차가운 겨울 육지 모래톱의 대비.",
      "mood": "비장함 → 망설임 → 바닷속 경이로움 → 배신과 공포 → 기지와 탈출 → 고요한 책임",
      "openQuestions": "자라의 선택 중 무엇이 가장 옳은 길이었을까? 결과를 바꾸지 못했더라도 돌아간 행동에는 의미가 있을까?",
      "freeNotes": "모든 선택지와 엔딩은 단일 정답 없이 선택의 무게와 대가를 남기도록 연출합니다."
    },
