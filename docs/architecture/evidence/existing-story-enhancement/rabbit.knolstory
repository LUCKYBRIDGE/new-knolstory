      },
      {
        "id": "review-main-002:shield-route:8",
        "chapterId": "review-main-002:shield-route",
        "order": 9,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "자라야.\n너는 정말 확인하러 가는 것이냐?",
