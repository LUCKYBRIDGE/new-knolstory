            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        },
        "audio": {
          "sounds": [
            {
              "id": "direction:review-main-002:palace:0:audio:sound:sfx-door",
              "assetId": "audio:sound:sfx-door",
              "volume": 0.5
            }
          ]
