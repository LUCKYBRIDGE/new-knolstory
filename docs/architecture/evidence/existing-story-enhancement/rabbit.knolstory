        }
      },
      {
        "id": "review-main-002:shoreAfterShield:2",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 3,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "토끼는 순식간에 몇 걸음 멀어졌다.\n그러다 뒤를 돌아보았다.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:3",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 4,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "토끼 선생.\n간을 두었다는 바위가 어디요?",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:4",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 5,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "자라 선생도 참 끈질기시오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:5",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 6,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "세상에 자기 간을 꺼내 바위 밑에 두고 다니는 토끼가 어디 있겠소?",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:6",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 7,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "……역시 그랬군.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:7",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 8,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "그 자리에서 살아 나가려면 뭐라도 말해야 했소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:8",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 9,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "생각할 시간도 없었지.\n입에서 가장 먼저 나온 거짓말을 붙잡았을 뿐이오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:9",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 10,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "알고 있었소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:10",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 11,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "알면서…\n내 말에 맞춰 준 거요?",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:11",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 12,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "그렇소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:12",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 13,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "토끼는 한동안 아무 말도 하지 않았다.\n겨울바람이 젖은 털을 흔들었다.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:13",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 14,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "자라 선생.\n나는 아직도 당신이 나를 속인 일이 화가 나오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:14",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 15,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "알고 있소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:15",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 16,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "그렇다고 용궁에서 나를 살려 준 일까지…",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:16",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 17,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "없던 일이 되는 것은 아니오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:17",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 18,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "나를 속인 것도 당신이고,\n살아 돌아올 틈을 만든 것도 당신이오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:18",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 19,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "두 일 중 하나가 다른 하나를 지워 주지는 않겠지요.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:19",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 20,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그 말에 나는 아무런 대답도 할 수 없었다.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:20",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 21,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "나는 이제 돌아가겠소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:21",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 22,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "가족들이 내가 사라졌다고 온 산을 뒤지고 있을 테니까.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:22",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 23,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "토끼 선생.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:23",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 24,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "다시는 남을 용궁으로 초대하는 일은 하지 마시오.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:24",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 25,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "토끼",
        "text": "자라 선생은 그런 일에 영 소질이 없소.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:25",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 26,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "토끼는 아주 조금 웃었다.\n그리고 몸을 돌려 숲으로 뛰어갔다.",
        "leftAssetId": "rabbit-turtle.character.rabbit-white-unified-720x900",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.rabbit-white-unified-720x900"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:26",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 27,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "몇 번의 뜀박질 뒤 긴 귀가 풀숲 너머로 사라졌다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:27",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 28,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "모래 위에는 나 혼자 남았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:28",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 29,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "토끼는 살았다.\n하지만 내 손에는 용왕님을 살릴 약이 없다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:29",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 30,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "용궁으로 돌아가면 내가 한 일을 직접 말해야 한다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:30",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 31,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "어떤 벌을 받을지도 모른다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:31",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 32,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "돌아가지 않는다면 토끼를 다시 쫓지 않아도 된다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:32",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 33,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "나 역시 용궁의 명령에서 벗어날 수 있다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:33",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 34,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "하지만 나를 기다리는 용왕님에게 아무 설명도 남기지 않게 된다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:34",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 35,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "목에 걸린 '바다의 숨결'이 새벽빛을 받아 희미하게 빛났다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:35",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 36,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "이제 마지막으로 정해야 한다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:36",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 37,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "자라의 생각",
        "text": "나는 내가 한 선택 뒤에 어떻게 남을 것인가.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:shoreAfterShield:37",
        "chapterId": "review-main-002:shoreAfterShield",
        "order": 38,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "토끼는 숲속으로 사라졌다.\n용왕은 아직\n나를 기다리고 있을 것이다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-shore-escape",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "flow": {
          "type": "choice",
          "options": [
            {
              "id": "exile",
              "label": "용궁으로 돌아가지 않는다.",
              "targetLineId": "review-main-002:ending-2:0"
            },
            {
              "id": "return",
              "label": "용궁으로 돌아가 모든 일을 직접 말한다.",
              "targetLineId": "review-main-002:ending-3:0"
            }
          ]
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:0",
        "chapterId": "review-main-002:ending-2",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "나는 오랫동안 바다를 바라보았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:1",
        "chapterId": "review-main-002:ending-2",
        "order": 2,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그러나 끝내 물속으로 들어가지 않았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:2",
        "chapterId": "review-main-002:ending-2",
        "order": 3,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "……여기까지 하겠습니다, 전하.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-2:3",
        "chapterId": "review-main-002:ending-2",
        "order": 4,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "누구에게 하는 말인지 나 자신도 알 수 없었다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:4",
        "chapterId": "review-main-002:ending-2",
        "order": 5,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "나는 목에 걸린 '바다의 숨결'을 풀었다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:5",
        "chapterId": "review-main-002:ending-2",
        "order": 6,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "어린 나를 살려 주었던 징표였다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:6",
        "chapterId": "review-main-002:ending-2",
        "order": 7,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그리고 오랫동안 내가 용궁의 신하라는 것을 알려 준 징표였다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:7",
        "chapterId": "review-main-002:ending-2",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "나는 그것을 파도가 닿는 바위 위에 내려놓았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:8",
        "chapterId": "review-main-002:ending-2",
        "order": 9,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그리고 바다를 등졌다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:9",
        "chapterId": "review-main-002:ending-2",
        "order": 10,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "그 뒤 나는 깊은 강과 연못을 옮겨 다니며 살았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:10",
        "chapterId": "review-main-002:ending-2",
        "order": 11,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "'바다의 숨결'이 없어진 뒤에는 예전처럼 오랫동안 짠물에 머물 수 없었다.\n\n그래서 다시는 용궁으로 돌아가지 않았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:11",
        "chapterId": "review-main-002:ending-2",
        "order": 12,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "나는 용왕님이 그 뒤 어떻게 되었는지도 직접 확인하지 못했다.\n\n때때로 바다에서 올라온 물고기에게 소식을 물어볼까 생각했지만, 매번 입을 열지 못했다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:12",
        "chapterId": "review-main-002:ending-2",
        "order": 13,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "토끼가 살아 있다는 사실을 떠올리면 마음 한쪽이 놓였고,\n용궁에 아무 설명도 남기지 않았다는 생각이 들면 또 다른 한쪽이 무거워졌다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:13",
        "chapterId": "review-main-002:ending-2",
        "order": 14,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "세월이 흘러도 둘 중 하나만 남지는 않았다.\n\n나는 그렇게 바다에서 멀어진 강물 속에서 살아갔다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-2:14",
        "chapterId": "review-main-002:ending-2",
        "order": 15,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "「돌아가지 않은 길」\n\n[생각해 보기]\n용궁으로 돌아가지 않은 것은 자신의 선택을 끝까지 지킨 행동이었을까?\n아니면 설명하고 책임질 기회를 놓친 행동이었을까?",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-river-winter",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "flow": {
          "type": "goto",
          "targetLineId": null
        },
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:0",
        "chapterId": "review-main-002:ending-3",
        "order": 1,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "나는 결국 몸을 돌려 다시 바다로 들어갔다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:1",
        "chapterId": "review-main-002:ending-3",
        "order": 2,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "돌아가는 길은 토끼를 데리고 올 때보다 훨씬 길게 느껴졌다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:2",
        "chapterId": "review-main-002:ending-3",
        "order": 3,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "용궁 대청에 도착했을 때 조개등은 거의 모두 꺼져 있었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:3",
        "chapterId": "review-main-002:ending-3",
        "order": 4,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "용왕님은 여전히 자리에 누워 있었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:4",
        "chapterId": "review-main-002:ending-3",
        "order": 5,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "……돌아왔구나.\n토끼는 어디 있느냐?",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:5",
        "chapterId": "review-main-002:ending-3",
        "order": 6,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "도망쳤습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:6",
        "chapterId": "review-main-002:ending-3",
        "order": 7,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "아니……\n제가 도망칠 수 있게 했습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:7",
        "chapterId": "review-main-002:ending-3",
        "order": 8,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "용왕님은 아무 말도 하지 않았다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:8",
        "chapterId": "review-main-002:ending-3",
        "order": 9,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "토끼의 간이 몸 밖에 있다는 말을 저는 처음부터 믿지 않았습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:9",
        "chapterId": "review-main-002:ending-3",
        "order": 10,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "토끼를 육지로 데려가기 위해 모르는 척했습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:10",
        "chapterId": "review-main-002:ending-3",
        "order": 11,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "전하께서 저를 믿으신다는 것을 알면서도 그렇게 했습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:11",
        "chapterId": "review-main-002:ending-3",
        "order": 12,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "왜 그랬느냐?",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:12",
        "chapterId": "review-main-002:ending-3",
        "order": 13,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "토끼를 이곳으로 속여 데려온 사람이 저였기 때문입니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:13",
        "chapterId": "review-main-002:ending-3",
        "order": 14,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "그대로 두면 제 거짓 때문에 토끼가 죽는다고 생각했습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:14",
        "chapterId": "review-main-002:ending-3",
        "order": 15,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "그래서 이번에는 나를 속였느냐.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:15",
        "chapterId": "review-main-002:ending-3",
        "order": 16,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "……그렇습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:16",
        "chapterId": "review-main-002:ending-3",
        "order": 17,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "용왕님은 한동안 눈을 감고 있었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:17",
        "chapterId": "review-main-002:ending-3",
        "order": 18,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "화가 난 것인지, 너무 지친 것인지 알 수 없었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:18",
        "chapterId": "review-main-002:ending-3",
        "order": 19,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "이리 가까이 오너라.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:19",
        "chapterId": "review-main-002:ending-3",
        "order": 20,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "용왕님의 손이 내 목의 '바다의 숨결'에 닿았다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:20",
        "chapterId": "review-main-002:ending-3",
        "order": 21,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "네가 왜 그런 선택을 했는지는 알겠다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:21",
        "chapterId": "review-main-002:ending-3",
        "order": 22,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "그렇다고 네가 나를 속였다는 사실까지 없어지는 것은 아니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:22",
        "chapterId": "review-main-002:ending-3",
        "order": 23,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "알고 있습니다.\n어떤 벌이든 받겠습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:23",
        "chapterId": "review-main-002:ending-3",
        "order": 24,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "그래서 돌아왔느냐?\n벌을 받기 위해?",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:24",
        "chapterId": "review-main-002:ending-3",
        "order": 25,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "제가 한 일을…\n제 입으로 말씀드리고 싶었습니다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:25",
        "chapterId": "review-main-002:ending-3",
        "order": 26,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "용왕님은 한동안 나를 바라보았다.\n그리고 아주 희미하게 웃었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:26",
        "chapterId": "review-main-002:ending-3",
        "order": 27,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "예전에는 내가 네게 사실대로 말하라고 가르쳤지.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:27",
        "chapterId": "review-main-002:ending-3",
        "order": 28,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "그런데 이번에는 내가 먼저 사실을 숨기라고 명했구나.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:28",
        "chapterId": "review-main-002:ending-3",
        "order": 29,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "아마 우리 둘 다…\n예전과 같은 자리로 돌아갈 수는 없겠지.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:29",
        "chapterId": "review-main-002:ending-3",
        "order": 30,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "지문",
        "text": "용왕님은 내 목에서 '바다의 숨결'을 천천히 풀었다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:30",
        "chapterId": "review-main-002:ending-3",
        "order": 31,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "이 징표는 용궁에서 살아갈 수 있도록 내가 네게 준 것이다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:31",
        "chapterId": "review-main-002:ending-3",
        "order": 32,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "하지만 네가 이곳에 남으면 다른 신하들이 너를 그냥 두지 않을 것이다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:32",
        "chapterId": "review-main-002:ending-3",
        "order": 33,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "강으로 가거라.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:33",
        "chapterId": "review-main-002:ending-3",
        "order": 34,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "이것을 벌이라고 생각해도 좋고…",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:34",
        "chapterId": "review-main-002:ending-3",
        "order": 35,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "내가 마지막으로 해 줄 수 있는 일이라고 생각해도 좋다.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:35",
        "chapterId": "review-main-002:ending-3",
        "order": 36,
        "type": "dialogue",
        "speaker": "right",
        "speakerName": "주인공",
        "text": "전하…….",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "R1"
        }
      },
      {
        "id": "review-main-002:ending-3:36",
        "chapterId": "review-main-002:ending-3",
        "order": 37,
        "type": "dialogue",
        "speaker": "left",
        "speakerName": "용왕",
        "text": "어서 가라.",
        "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [
            {
              "key": "L1",
              "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
            }
          ],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ],
          "speakerActorKey": "L1"
        }
      },
      {
        "id": "review-main-002:ending-3:37",
        "chapterId": "review-main-002:ending-3",
        "order": 38,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "나는 그날 새벽 용궁을 떠났다.\n\n물문이 닫히기 직전 한 번 뒤를 돌아보았다. 어두운 대청 안에서 용왕님이 아주 작게 보였다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        },
        "audio": {
          "sounds": [
            {
              "id": "direction:review-main-002:ending-3:37:audio:sound:sfx-door",
              "assetId": "audio:sound:sfx-door",
              "volume": 0.5
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:38",
        "chapterId": "review-main-002:ending-3",
        "order": 39,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "얼마 뒤 멀리 바닷속에서 낮고 긴 종소리가 들렸다.\n\n나는 그 소리의 뜻을 알고 있었다. 하지만 돌아가지 않았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:39",
        "chapterId": "review-main-002:ending-3",
        "order": 40,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "'바다의 숨결'을 잃은 나는 이후 강물에서 살았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:40",
        "chapterId": "review-main-002:ending-3",
        "order": 41,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "토끼를 살린 것이 옳았는지, 용왕을 속인 것이 잘못이었는지, 돌아가 고백한 일이 무엇을 바꾸었는지.\n\n오랜 시간이 지나도 하나의 답으로 정리되지는 않았다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:41",
        "chapterId": "review-main-002:ending-3",
        "order": 42,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "다만 그날의 선택들은 모두 내 것이었다.\n\n그리고 나는 그 선택들을 잊지 않은 채 살아갔다.",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "stageComposition": {
          "leftActors": [],
          "rightActors": [
            {
              "key": "R1",
              "assetId": "rabbit-turtle.character.turtle-unified-720x900"
            }
          ]
        }
      },
      {
        "id": "review-main-002:ending-3:42",
        "chapterId": "review-main-002:ending-3",
        "order": 43,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "「돌아온 자라」\n\n[생각해 보기]\n자라가 다시 용궁으로 돌아온 것은 무엇을 바꾸었을까?\n결과를 바꾸지는 못했더라도 돌아가는 행동에는 의미가 있었을까?",
        "leftAssetId": "",
        "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
        "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
        "purposeNote": "",
        "emotionNote": "",
        "directionNote": "",
        "flow": {
          "type": "goto",
          "targetLineId": null
        },
