          "chapterId": "e68c27bb-7614-4159-b142-b0e8f809c5a3",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "coSpeakerNames": [],
          "text": "별빛 아래에서 길 잃은 친구를 만났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
