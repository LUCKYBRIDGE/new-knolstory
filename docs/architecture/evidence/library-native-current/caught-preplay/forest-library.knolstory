        {
          "id": "b0ec902a-475d-4b96-a15b-06115291157e",
          "chapterId": "b3ed24aa-7e42-4821-bd12-d8229bc0bce2",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "coSpeakerNames": [],
          "text": "햇빛 아래에서 작은 제비를 만났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "workingTitle": "",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          }
        },
        {
          "id": "ed59be3a-19ad-4907-ad44-668cb987a6b9",
          "chapterId": "b3ed24aa-7e42-4821-bd12-d8229bc0bce2",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "제비가 알려 준 길을 따라 다리로 향했다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
