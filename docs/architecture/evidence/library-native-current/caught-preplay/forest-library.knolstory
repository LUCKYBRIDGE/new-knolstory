        {
          "id": "753f0ae9-5792-4019-8e69-b5167fdc984d",
          "chapterId": "50755f8d-4076-4d96-8dd3-bfc6d607fca9",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "흥부는 친구에게 줄 선물을 챙겼다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "left-1791416753236",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "left-1791416753236"
          }
        },
        {
          "id": "8b4f558a-f9e0-44c8-ab60-49b18c515f25",
          "chapterId": "50755f8d-4076-4d96-8dd3-bfc6d607fca9",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "나는 흥부와 함께 숲 입구로 걸었다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "flow": {
            "type": "goto",
            "targetLineId": "ff31a47d-ee16-4335-8996-3ad217adb491"
          }
        },
        {
          "id": "ff31a47d-ee16-4335-8996-3ad217adb491",
          "chapterId": "d1890efc-8563-41d4-afe3-80842e562ef8",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "",
          "text": "숲 깊은 곳에서 두 길이 나타났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "presentation": {
            "clearFollowingEffects": true
          }
        },
        {
          "id": "d7983fa1-4bf0-4fca-a1bd-8f9b095a0d0f",
          "chapterId": "d1890efc-8563-41d4-afe3-80842e562ef8",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "밝은 길에서는 새가 노래하고, 밤길에서는 별이 빛났다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "left-1791416753467",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "left-1791416753467"
          }
        },
        {
          "id": "463d2570-e6c7-4929-81ea-617096120bc5",
          "chapterId": "d1890efc-8563-41d4-afe3-80842e562ef8",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "어느 길로 친구를 찾아갈까?",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
