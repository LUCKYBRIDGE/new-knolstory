            "targetLineId": null
          }
        },
        {
          "id": "review-main-002:ending-3:0",
          "chapterId": "review-main-002:ending-3",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "나는 결국 몸을 돌려 다시 바다로 들어갔다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:1",
          "chapterId": "review-main-002:ending-3",
          "order": 2,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "돌아가는 길은 토끼를 데리고 올 때보다 훨씬 길게 느껴졌다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:2",
          "chapterId": "review-main-002:ending-3",
          "order": 3,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "용궁 대청에 도착했을 때 조개등은 거의 모두 꺼져 있었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:3",
          "chapterId": "review-main-002:ending-3",
          "order": 4,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "용왕님은 여전히 자리에 누워 있었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:4",
          "chapterId": "review-main-002:ending-3",
          "order": 5,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "……돌아왔구나.\n토끼는 어디 있느냐?",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:5",
          "chapterId": "review-main-002:ending-3",
          "order": 6,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "도망쳤습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:6",
          "chapterId": "review-main-002:ending-3",
          "order": 7,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "아니……\n제가 도망칠 수 있게 했습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:7",
          "chapterId": "review-main-002:ending-3",
          "order": 8,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "용왕님은 아무 말도 하지 않았다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:8",
          "chapterId": "review-main-002:ending-3",
          "order": 9,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "토끼의 간이 몸 밖에 있다는 말을 저는 처음부터 믿지 않았습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:9",
          "chapterId": "review-main-002:ending-3",
          "order": 10,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "토끼를 육지로 데려가기 위해 모르는 척했습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:10",
          "chapterId": "review-main-002:ending-3",
          "order": 11,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "전하께서 저를 믿으신다는 것을 알면서도 그렇게 했습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:11",
          "chapterId": "review-main-002:ending-3",
          "order": 12,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "왜 그랬느냐?",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:12",
          "chapterId": "review-main-002:ending-3",
          "order": 13,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "토끼를 이곳으로 속여 데려온 사람이 저였기 때문입니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:13",
          "chapterId": "review-main-002:ending-3",
          "order": 14,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "그대로 두면 제 거짓 때문에 토끼가 죽는다고 생각했습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:14",
          "chapterId": "review-main-002:ending-3",
          "order": 15,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "그래서 이번에는 나를 속였느냐.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:15",
          "chapterId": "review-main-002:ending-3",
          "order": 16,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "……그렇습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:16",
          "chapterId": "review-main-002:ending-3",
          "order": 17,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "용왕님은 한동안 눈을 감고 있었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:17",
          "chapterId": "review-main-002:ending-3",
          "order": 18,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "화가 난 것인지, 너무 지친 것인지 알 수 없었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:18",
          "chapterId": "review-main-002:ending-3",
          "order": 19,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "이리 가까이 오너라.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:19",
          "chapterId": "review-main-002:ending-3",
          "order": 20,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "지문",
          "text": "용왕님의 손이 내 목의 '바다의 숨결'에 닿았다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:20",
          "chapterId": "review-main-002:ending-3",
          "order": 21,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "네가 왜 그런 선택을 했는지는 알겠다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:21",
          "chapterId": "review-main-002:ending-3",
          "order": 22,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "그렇다고 네가 나를 속였다는 사실까지 없어지는 것은 아니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:22",
          "chapterId": "review-main-002:ending-3",
          "order": 23,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "알고 있습니다.\n어떤 벌이든 받겠습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:23",
          "chapterId": "review-main-002:ending-3",
          "order": 24,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "그래서 돌아왔느냐?\n벌을 받기 위해?",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:24",
          "chapterId": "review-main-002:ending-3",
          "order": 25,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "제가 한 일을…\n제 입으로 말씀드리고 싶었습니다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:25",
          "chapterId": "review-main-002:ending-3",
          "order": 26,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "용왕님은 한동안 나를 바라보았다.\n그리고 아주 희미하게 웃었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:26",
          "chapterId": "review-main-002:ending-3",
          "order": 27,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "예전에는 내가 네게 사실대로 말하라고 가르쳤지.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:27",
          "chapterId": "review-main-002:ending-3",
          "order": 28,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "그런데 이번에는 내가 먼저 사실을 숨기라고 명했구나.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:28",
          "chapterId": "review-main-002:ending-3",
          "order": 29,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "아마 우리 둘 다…\n예전과 같은 자리로 돌아갈 수는 없겠지.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:29",
          "chapterId": "review-main-002:ending-3",
          "order": 30,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "지문",
          "text": "용왕님은 내 목에서 '바다의 숨결'을 천천히 풀었다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:30",
          "chapterId": "review-main-002:ending-3",
          "order": 31,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "이 징표는 용궁에서 살아갈 수 있도록 내가 네게 준 것이다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:31",
          "chapterId": "review-main-002:ending-3",
          "order": 32,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "하지만 네가 이곳에 남으면 다른 신하들이 너를 그냥 두지 않을 것이다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:32",
          "chapterId": "review-main-002:ending-3",
          "order": 33,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "강으로 가거라.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:33",
          "chapterId": "review-main-002:ending-3",
          "order": 34,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "이것을 벌이라고 생각해도 좋고…",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:34",
          "chapterId": "review-main-002:ending-3",
          "order": 35,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "내가 마지막으로 해 줄 수 있는 일이라고 생각해도 좋다.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:35",
          "chapterId": "review-main-002:ending-3",
          "order": 36,
          "type": "dialogue",
          "speaker": "right",
          "speakerName": "주인공",
          "text": "전하…….",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "R1"
          }
        },
        {
          "id": "review-main-002:ending-3:36",
          "chapterId": "review-main-002:ending-3",
          "order": 37,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "용왕",
          "text": "어서 가라.",
          "leftAssetId": "rabbit-turtle.character.dragonking-sick-elder-attached",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "L1",
                "assetId": "rabbit-turtle.character.dragonking-sick-elder-attached"
              }
            ],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ],
            "speakerActorKey": "L1"
          }
        },
        {
          "id": "review-main-002:ending-3:37",
          "chapterId": "review-main-002:ending-3",
          "order": 38,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "나는 그날 새벽 용궁을 떠났다.\n\n물문이 닫히기 직전 한 번 뒤를 돌아보았다. 어두운 대청 안에서 용왕님이 아주 작게 보였다.",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:38",
          "chapterId": "review-main-002:ending-3",
          "order": 39,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "얼마 뒤 멀리 바닷속에서 낮고 긴 종소리가 들렸다.\n\n나는 그 소리의 뜻을 알고 있었다. 하지만 돌아가지 않았다.",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:39",
          "chapterId": "review-main-002:ending-3",
          "order": 40,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "'바다의 숨결'을 잃은 나는 이후 강물에서 살았다.",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:40",
          "chapterId": "review-main-002:ending-3",
          "order": 41,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "토끼를 살린 것이 옳았는지, 용왕을 속인 것이 잘못이었는지, 돌아가 고백한 일이 무엇을 바꾸었는지.\n\n오랜 시간이 지나도 하나의 답으로 정리되지는 않았다.",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:41",
          "chapterId": "review-main-002:ending-3",
          "order": 42,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "다만 그날의 선택들은 모두 내 것이었다.\n\n그리고 나는 그 선택들을 잊지 않은 채 살아갔다.",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          }
        },
        {
          "id": "review-main-002:ending-3:42",
          "chapterId": "review-main-002:ending-3",
          "order": 43,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "text": "「돌아온 자라」\n\n[생각해 보기]\n자라가 다시 용궁으로 돌아온 것은 무엇을 바꾸었을까?\n결과를 바꾸지는 못했더라도 돌아가는 행동에는 의미가 있었을까?",
          "leftAssetId": "",
          "rightAssetId": "rabbit-turtle.character.turtle-unified-720x900",
          "backgroundId": "rabbit-turtle.background.rabbit-turtle-bg-palace-confession",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": [
              {
                "key": "R1",
                "assetId": "rabbit-turtle.character.turtle-unified-720x900"
              }
            ]
          },
          "flow": {
            "type": "goto",
            "targetLineId": null
          }
        }
      ],
      "updatedAt": "pinky-ne-site 804fe9f"
    }
  },
  "audioResources": [
    {
      "id": "audio:custom:613933726c3a844f26a6ab270a6e9166900963eecab6975cd8585a2175dda151:mp3",
