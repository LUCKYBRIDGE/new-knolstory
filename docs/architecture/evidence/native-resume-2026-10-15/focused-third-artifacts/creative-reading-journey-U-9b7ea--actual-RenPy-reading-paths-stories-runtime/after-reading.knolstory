        },
        {
          "id": "5cd6d638-f3d1-4b31-8010-a431828bb05e",
          "chapterId": "5ee207ea-2327-4722-9529-b298bcb4aa19",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "coSpeakerNames": [],
          "text": "햇빛 아래에서 작은 제비를 만났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "workingTitle": "",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          }
        },
        {
          "id": "c0a82e65-4c22-4e4d-9948-f5dc16ea9e1f",
          "chapterId": "5ee207ea-2327-4722-9529-b298bcb4aa19",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "제비가 알려 준 길을 따라 다리로 향했다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
