          }
        },
        {
          "id": "4cb9afdf-379d-4b50-bb0c-70460bf9c071",
          "chapterId": "7e0207e9-998b-4964-84c5-b15a46df5991",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "해설",
          "coSpeakerNames": [],
          "text": "별빛 아래에서 길 잃은 친구를 만났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "workingTitle": "",
          "purposeNote": "",
