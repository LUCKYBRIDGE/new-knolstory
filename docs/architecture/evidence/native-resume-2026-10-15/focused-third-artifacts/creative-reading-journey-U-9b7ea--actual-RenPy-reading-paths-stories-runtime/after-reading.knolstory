      "lines": [
        {
          "id": "c6e8eff8-537d-452c-9b27-eb6c474b3ea4",
          "chapterId": "06533bca-58c8-4cc5-9cff-d924f7ed1f93",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "",
          "text": "아침 빛이 작은 숲을 깨웠다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "audio": {
            "sounds": [
