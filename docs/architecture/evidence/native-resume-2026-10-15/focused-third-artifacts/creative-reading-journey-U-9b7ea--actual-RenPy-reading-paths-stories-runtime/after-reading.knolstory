        {
          "id": "cbd2bf90-0f2d-4f04-9fe2-ccb39636eb43",
          "chapterId": "06533bca-58c8-4cc5-9cff-d924f7ed1f93",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "흥부는 친구에게 줄 선물을 챙겼다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "left-1792074259134",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "left-1792074259134",
            "speakerActorKeys": [
              "left-1792074259134"
            ]
          }
        },
        {
          "id": "968731ac-3e1d-43e5-ab8e-11e26c598991",
          "chapterId": "06533bca-58c8-4cc5-9cff-d924f7ed1f93",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "나는 흥부와 함께 숲 입구로 걸었다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "flow": {
            "type": "goto",
            "targetLineId": "62cffff5-fe1e-4015-9c46-77e0b1b0865a"
          }
        },
        {
          "id": "62cffff5-fe1e-4015-9c46-77e0b1b0865a",
          "chapterId": "ee2daf27-d1a0-4077-8623-f0616752dc9c",
          "order": 1,
          "type": "narration",
          "speaker": "narration",
          "speakerName": "",
          "text": "숲 깊은 곳에서 두 길이 나타났다.",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "presentation": {
            "clearFollowingEffects": true
          }
        },
        {
          "id": "f2547513-3bb3-425d-86fb-bf5a257e009c",
          "chapterId": "ee2daf27-d1a0-4077-8623-f0616752dc9c",
          "order": 2,
          "type": "dialogue",
          "speaker": "left",
          "speakerName": "흥부",
          "text": "밝은 길에서는 새가 노래하고, 밤길에서는 별이 빛났다.",
          "leftAssetId": "heungbu.character.heungbu-young",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "inheritActors": false,
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [
              {
                "key": "left-1792074260051",
                "assetId": "heungbu.character.heungbu-young"
              }
            ],
            "rightActors": [],
            "speakerActorKey": "left-1792074260051",
            "speakerActorKeys": [
              "left-1792074260051"
            ]
          }
        },
        {
          "id": "fe6e303d-7d65-4544-b470-a444f060b697",
          "chapterId": "ee2daf27-d1a0-4077-8623-f0616752dc9c",
          "order": 3,
          "type": "dialogue",
          "speaker": "narration",
          "speakerName": "흥부",
          "text": "어느 길로 친구를 찾아갈까?",
          "leftAssetId": "",
          "rightAssetId": "",
          "backgroundId": "seonnyeo.background.BG-forest-roots",
          "purposeNote": "",
          "emotionNote": "",
          "directionNote": "",
          "stageComposition": {
            "leftActors": [],
            "rightActors": []
          },
          "flow": {
            "type": "choice",
