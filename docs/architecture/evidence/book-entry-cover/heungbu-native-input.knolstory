        "chapterId": "chapter-12b",
        "order": 32,
        "type": "narration",
        "speaker": "narration",
        "speakerName": "해설",
        "text": "밤이 늦자 놀부 가족은 자기 집으로 돌아갔다.\n\n다음 날 아침, 아이 하나가 두 집 사이를 뛰어갔다.",
        "leftAssetId": "heungbu.character.heungbu-default",
        "rightAssetId": "heungbu.character.nolbu-sharing",
